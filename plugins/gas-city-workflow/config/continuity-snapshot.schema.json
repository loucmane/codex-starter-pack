{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gas-city.local/schemas/continuity-snapshot.v2.json",
  "title": "Gas City continuity snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_sha256", "runtime", "ledgers", "projects"],
  "properties": {
    "schema": {"const": "gas-city-workflow.continuity-snapshot.v2"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city"],
      "properties": {
        "city": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_ledger", "tmux"],
          "properties": {
            "session_ledger": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "authority", "sessions"],
              "properties": {
                "status": {"enum": ["complete", "unknown"]},
                "authority": {"const": "gc-session-list-v1"},
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "session_name", "state", "transport", "closed"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "session_name": {"type": "string"},
                      "state": {"type": "string"},
                      "transport": {"type": "string"},
                      "closed": {"type": "boolean"}
                    }
                  }
                }
              }
            },
            "tmux": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "authority", "uid", "servers"],
              "properties": {
                "status": {"enum": ["complete", "unknown"]},
                "authority": {"const": "same-uid-procfs"},
                "uid": {"type": "integer", "minimum": 0},
                "servers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "pid",
                      "sid",
                      "ppid",
                      "uid",
                      "start_ticks",
                      "cmdline_sha256",
                      "argv0",
                      "socket_label",
                      "child_pids"
                    ],
                    "properties": {
                      "pid": {"type": "integer", "minimum": 1},
                      "sid": {"type": "integer", "minimum": 1},
                      "ppid": {"type": "integer", "minimum": 0},
                      "uid": {"type": "integer", "minimum": 0},
                      "start_ticks": {"type": "integer", "minimum": 0},
                      "cmdline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "argv0": {"const": "tmux"},
                      "socket_label": {"const": "city"},
                      "child_pids": {
                        "type": "array",
                        "items": {"type": "integer", "minimum": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rig", "beads"],
        "properties": {
          "rig": {"type": "string"},
          "beads": {"type": "array"}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "repository",
          "rig",
          "workflow_profile",
          "aegis",
          "git",
          "runtime",
          "obsidian",
          "followups",
          "residue_dispositions"
        ],
        "properties": {
          "git": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical", "branches", "worktrees", "open_prs"],
            "properties": {
              "canonical": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "head",
                  "branch",
                  "detached",
                  "target_ref",
                  "target_head",
                  "ahead",
                  "behind",
                  "tracked_clean"
                ],
                "properties": {
                  "path": {"type": "string", "pattern": "^/"},
                  "head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
                  "branch": {"type": ["string", "null"]},
                  "detached": {"type": "boolean"},
                  "target_ref": {"type": "string", "minLength": 1},
                  "target_head": {
                    "type": ["string", "null"],
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "ahead": {"type": ["integer", "null"], "minimum": 0},
                  "behind": {"type": ["integer", "null"], "minimum": 0},
                  "tracked_clean": {"type": "boolean"}
                }
              },
              "branches": {"type": "array"},
              "worktrees": {"type": "array"},
              "open_prs": {"type": "array"}
            }
          }
        }
      }
    }
  }
}
