#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: install-codex-gpg-readiness --check|--apply [--helper-dest PATH] [--shell-dest PATH]" >&2
  exit 64
}

mode=""
helper_dest="${HOME}/.local/bin/codex-gpg-readiness"
shell_dest="${HOME}/.config/codex/gpg-readiness.zsh"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check|--apply)
      [ -z "$mode" ] || usage
      mode="$1"
      shift
      ;;
    --helper-dest)
      [ "$#" -ge 2 ] || usage
      helper_dest="$2"
      shift 2
      ;;
    --shell-dest)
      [ "$#" -ge 2 ] || usage
      shell_dest="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
[ -n "$mode" ] || usage

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
helper_source="${repo_root}/scripts/codex-gpg-readiness"
shell_source="${repo_root}/scripts/shell/codex-gpg-readiness.zsh"
[ -f "$helper_source" ] || { echo "helper source missing: $helper_source" >&2; exit 1; }
[ -f "$shell_source" ] || { echo "shell source missing: $shell_source" >&2; exit 1; }

check_installed() {
  [ -f "$helper_dest" ] && [ ! -L "$helper_dest" ] && [ -x "$helper_dest" ] || {
    echo "stable GPG readiness helper missing or non-executable: $helper_dest" >&2
    return 1
  }
  [ -f "$shell_dest" ] && [ ! -L "$shell_dest" ] || {
    echo "stable GPG shell integration missing: $shell_dest" >&2
    return 1
  }
  [ "$(stat -c '%a' -- "$helper_dest")" = "755" ] || {
    echo "stable GPG readiness helper mode is not 0755: $helper_dest" >&2
    return 1
  }
  [ "$(stat -c '%a' -- "$shell_dest")" = "644" ] || {
    echo "stable GPG shell integration mode is not 0644: $shell_dest" >&2
    return 1
  }
  cmp -s -- "$helper_source" "$helper_dest" || {
    echo "stable GPG readiness helper differs from reviewed source: $helper_dest" >&2
    return 1
  }
  cmp -s -- "$shell_source" "$shell_dest" || {
    echo "stable GPG shell integration differs from reviewed source: $shell_dest" >&2
    return 1
  }
}

if [ "$mode" = "--check" ]; then
  check_installed
  exit 0
fi

for destination_dir in "$(dirname -- "$helper_dest")" "$(dirname -- "$shell_dest")"; do
  if [ -e "$destination_dir" ]; then
    [ -d "$destination_dir" ] && [ ! -L "$destination_dir" ] || {
      echo "installation parent is not a real directory: $destination_dir" >&2
      exit 1
    }
  else
    /usr/bin/install -d -m 0755 -- "$destination_dir"
  fi
done
helper_tmp=$(mktemp -- "${helper_dest}.tmp.XXXXXX")
shell_tmp=$(mktemp -- "${shell_dest}.tmp.XXXXXX")
cleanup() {
  rm -f -- "$helper_tmp" "$shell_tmp"
}
trap cleanup EXIT HUP INT TERM
/usr/bin/install -m 0755 -- "$helper_source" "$helper_tmp"
/usr/bin/install -m 0644 -- "$shell_source" "$shell_tmp"
/usr/bin/mv -f -- "$helper_tmp" "$helper_dest"
/usr/bin/mv -f -- "$shell_tmp" "$shell_dest"
trap - EXIT HUP INT TERM
check_installed
