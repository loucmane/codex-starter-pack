#!/usr/bin/env bash
set -euo pipefail

readonly FINGERPRINT="FD5585922F5335BC378AD8D42ECF4432C7E7982D"
readonly KEYGRIP="640406DD1B34A5EA0BB7CB46F21071BB3DB370FA"
readonly SCHEMA="codex.gpg-readiness.v2"
readonly PROOF_SCHEMA="codex.gpg-readiness-proof.v1"
readonly PROOF_TTL_SECONDS=2592000
readonly RUNTIME_BASE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly PROOF_DIR="${RUNTIME_BASE%/}/codex-gpg-readiness"
readonly PROOF_FILE="${PROOF_DIR}/${KEYGRIP}.proof"
readonly BOOT_ID_PATH="/proc/sys/kernel/random/boot_id"

usage() {
  echo "usage: codex-gpg-readiness check|unlock [--json]" >&2
  exit 64
}

mode="${1:-}"
[ "$mode" = "check" ] || [ "$mode" = "unlock" ] || usage
shift
json=false
if [ "${1:-}" = "--json" ]; then
  json=true
  shift
fi
[ "$#" -eq 0 ] || usage

emit() {
  local status="$1"
  local agent_running="$2"
  local cached="$3"
  local proof="$4"
  if $json; then
    printf '{"agent_running":%s,"cached":%s,"fingerprint":"%s","keygrip":"%s","proof":"%s","schema":"%s","status":"%s"}\n' \
      "$agent_running" "$cached" "$FINGERPRINT" "$KEYGRIP" "$proof" "$SCHEMA" "$status"
  else
    printf 'GPG %s: fingerprint=%s agent_running=%s cached=%s proof=%s\n' \
      "$status" "$FINGERPRINT" "$agent_running" "$cached" "$proof"
  fi
}

current_agent_pid() {
  local response
  response=$(gpg-connect-agent --no-autostart 'getinfo pid' /bye 2>/dev/null) || return 1
  awk '
    $1 == "D" && $2 ~ /^[0-9]+$/ { pid = $2 }
    END { if (pid == "") exit 1; print pid }
  ' <<<"$response"
}

exact_key_cached() {
  local response
  response=$(gpg-connect-agent --no-autostart "keyinfo $KEYGRIP" /bye 2>/dev/null) || return 12
  if ! awk -v grip="$KEYGRIP" '
    $1 == "S" && $2 == "KEYINFO" && $3 == grip { found = 1 }
    END { exit found ? 0 : 1 }
  ' <<<"$response"; then
    return 12
  fi
  awk -v grip="$KEYGRIP" '
    $1 == "S" && $2 == "KEYINFO" && $3 == grip && $7 == "1" { ready = 1 }
    END { exit ready ? 0 : 1 }
  ' <<<"$response"
}

proof_valid() {
  local expected_agent_pid="$1"
  local current_uid mode owner boot_id now
  local schema="" fingerprint="" keygrip="" agent_pid=""
  local proof_boot_id="" created_epoch="" expires_epoch="" fields=0

  [ -f "$PROOF_FILE" ] && [ ! -L "$PROOF_FILE" ] || return 1
  [ -d "$PROOF_DIR" ] && [ ! -L "$PROOF_DIR" ] || return 1
  current_uid=$(id -u)
  mode=$(stat -c '%a' "$PROOF_FILE" 2>/dev/null) || return 1
  owner=$(stat -c '%u' "$PROOF_FILE" 2>/dev/null) || return 1
  [ "$mode" = "600" ] && [ "$owner" = "$current_uid" ] || return 1

  while IFS='=' read -r key value; do
    case "$key" in
      schema) [ -z "$schema" ] || return 1; schema="$value" ;;
      fingerprint) [ -z "$fingerprint" ] || return 1; fingerprint="$value" ;;
      keygrip) [ -z "$keygrip" ] || return 1; keygrip="$value" ;;
      agent_pid) [ -z "$agent_pid" ] || return 1; agent_pid="$value" ;;
      boot_id) [ -z "$proof_boot_id" ] || return 1; proof_boot_id="$value" ;;
      created_epoch) [ -z "$created_epoch" ] || return 1; created_epoch="$value" ;;
      expires_epoch) [ -z "$expires_epoch" ] || return 1; expires_epoch="$value" ;;
      *) return 1 ;;
    esac
    fields=$((fields + 1))
  done <"$PROOF_FILE"

  [ "$fields" -eq 7 ] || return 1
  [ "$schema" = "$PROOF_SCHEMA" ] || return 1
  [ "$fingerprint" = "$FINGERPRINT" ] || return 1
  [ "$keygrip" = "$KEYGRIP" ] || return 1
  [ "$agent_pid" = "$expected_agent_pid" ] || return 1
  [[ "$agent_pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$created_epoch" =~ ^[0-9]+$ ]] || return 1
  [[ "$expires_epoch" =~ ^[0-9]+$ ]] || return 1
  [ -r "$BOOT_ID_PATH" ] || return 1
  boot_id=$(<"$BOOT_ID_PATH")
  [ "$proof_boot_id" = "$boot_id" ] || return 1
  now=$(date +%s)
  [ "$created_epoch" -le "$now" ] || return 1
  [ "$expires_epoch" -gt "$now" ] || return 1
  [ $((expires_epoch - created_epoch)) -eq "$PROOF_TTL_SECONDS" ] || return 1
}

write_proof() {
  local agent_pid="$1"
  local boot_id now expires temporary

  [ -r "$BOOT_ID_PATH" ] || {
    echo "WSL boot identity is unavailable; refusing to record GPG readiness" >&2
    return 1
  }
  boot_id=$(<"$BOOT_ID_PATH")
  now=$(date +%s)
  expires=$((now + PROOF_TTL_SECONDS))
  umask 077
  mkdir -p -- "$PROOF_DIR"
  [ -d "$PROOF_DIR" ] && [ ! -L "$PROOF_DIR" ] || return 1
  chmod 700 -- "$PROOF_DIR"
  temporary=$(mktemp "${PROOF_FILE}.tmp.XXXXXX")
  {
    printf 'schema=%s\n' "$PROOF_SCHEMA"
    printf 'fingerprint=%s\n' "$FINGERPRINT"
    printf 'keygrip=%s\n' "$KEYGRIP"
    printf 'agent_pid=%s\n' "$agent_pid"
    printf 'boot_id=%s\n' "$boot_id"
    printf 'created_epoch=%s\n' "$now"
    printf 'expires_epoch=%s\n' "$expires"
  } >"$temporary"
  chmod 600 -- "$temporary"
  mv -f -- "$temporary" "$PROOF_FILE"
}

check_status() {
  local agent_pid cache_rc=0
  if ! agent_pid=$(current_agent_pid); then
    emit agent-unavailable false false none
    return 10
  fi
  exact_key_cached || cache_rc=$?
  if [ "$cache_rc" -eq 0 ]; then
    emit ready true true agent-cache
    return 0
  fi
  if [ "$cache_rc" -eq 12 ]; then
    emit key-unavailable true false none
    return 12
  fi
  if proof_valid "$agent_pid"; then
    emit ready true false agent-epoch-signature
    return 0
  fi
  emit cold true false none
  return 11
}

if [ "$mode" = "check" ]; then
  check_status
  exit $?
fi

if check_status >/dev/null; then
  check_status
  exit 0
fi

if ! command -v gpgconf >/dev/null 2>&1 \
  || ! command -v gpg-connect-agent >/dev/null 2>&1 \
  || ! command -v gpg >/dev/null 2>&1; then
  echo "GPG tooling is unavailable" >&2
  exit 12
fi
if ! { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; }; then
  echo "FD55 unlock requires an interactive terminal" >&2
  exit 13
fi

gpgconf --launch gpg-agent
tty_path=$(tty 2>/dev/null) || {
  echo "Unable to identify the interactive terminal for GPG pinentry" >&2
  exit 13
}
export GPG_TTY="$tty_path"
gpg-connect-agent updatestartuptty /bye >/dev/null
gpg --yes \
  --pinentry-mode ask \
  --local-user "${FINGERPRINT}!" \
  --detach-sign --output /dev/null /dev/null

agent_pid=$(current_agent_pid) || {
  echo "GPG agent disappeared after the FD55 signing proof" >&2
  exit 14
}
write_proof "$agent_pid"
if ! check_status >/dev/null; then
  echo "FD55 signing proof could not be bound to the current GPG agent epoch" >&2
  exit 14
fi
check_status
